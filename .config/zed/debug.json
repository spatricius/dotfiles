// Global debug tasks
//
// For more documentation on how to configure debug tasks,
// see: https://zed.dev/docs/debugger
[
    {
        "label": "PHP: Listen to Xdebug",
        "adapter": "Xdebug",
        "request": "launch",
        "port": 9003,
        "hostname": "0.0.0.0",
        "pathMappings": {
            "/var/www/": "$ZED_WORKTREE_ROOT/",
        },
        "maxConnections": 10,
        "log": true,
    },
]
